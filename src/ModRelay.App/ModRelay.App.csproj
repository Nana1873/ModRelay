<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\modrelay.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <AssemblyName>ModRelay</AssemblyName>
    <Product>ModRelay</Product>
    <Description>Lightweight FFXIV mod relay for TexTools and Penumbra.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModRelay.Core\ModRelay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModRelay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\modrelay.ico" LogicalName="ModRelay.AppIcon.ico" />
  </ItemGroup>

</Project>
